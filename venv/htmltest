  <!-- API Call Log for debugging -->
  <button class="debug-toggle" id="debugToggle">Debug</button>
  <div class="api-call-log" id="apiCallLog"></div>

  <script>
    // Generate a random device ID for simulation purposes
    function generateDeviceId() {
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      });
    }

    // Password visibility toggle
    document.querySelector('.toggle-password').addEventListener('click', function() {
      const passwordInput = document.getElementById('password');
      if(passwordInput.type === 'password') {
        passwordInput.type = 'text';
        this.textContent = '👁️‍🗨️';
      } else {
        passwordInput.type = 'password';
        this.textContent = '👁️';
      }
    });

    // Debug toggle
    document.getElementById('debugToggle').addEventListener('click', function() {
      const apiCallLog = document.getElementById('apiCallLog');
      if(apiCallLog.style.display === 'none' || apiCallLog.style.display === '') {
        apiCallLog.style.display = 'block';
      } else {
        apiCallLog.style.display = 'none';
      }
    });

    // Global variables
    const deviceId = generateDeviceId();
    let authToken = null;

    // Log API calls
    function logApiCall(endpoint, method, success = true) {
      const apiCallLog = document.getElementById('apiCallLog');
      const apiCall = document.createElement('div');
      apiCall.className = `api-call ${success ? 'success' : 'error'}`;
      apiCall.innerHTML = `[${new Date().toLocaleTimeString()}] ${method} <span class="endpoint">${endpoint}</span> - ${success ? 'OK' : 'FAILED'}`;
      apiCallLog.appendChild(apiCall);
      apiCallLog.scrollTop = apiCallLog.scrollHeight;
    }

    // Simulated API calls
    function simulateApiCall(endpoint, method, data = null, success = true, delay = 500) {
      return new Promise((resolve, reject) => {
        setTimeout(() => {
          logApiCall(endpoint, method, success);
          if (success) {
            resolve({ status: 200, data: data || { success: true } });
          } else {
            reject({ status: 401, message: 'Unauthorized' });
          }
        }, delay);
      });
    }

    // Login handler
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const statusMessage = document.getElementById('statusMessage');
      const loginButton = document.querySelector('.login-button');
      const spinner = document.getElementById('loginSpinner');
      const buttonText = document.querySelector('.button-text');
      
      // Show loading state
      spinner.style.display = 'inline-block';
      buttonText.textContent = 'Autenticando...';
      loginButton.disabled = true;
      
      // Hide any previous status messages
      statusMessage.style.display = 'none';
      statusMessage.className = 'status-message';
      
      // Simulate login API call
      simulateApiCall('/proxy/login', 'POST', { email, password, deviceId }, true, 1500)
        .then(response => {
          // Simulate getting auth token
          authToken = 'eyJraWQiOiI2OTJkODI4MS1hZTBmLTRkZDgtYmI4OC1iMjM3MDNiZTY0MmEiLCJhbGciOiJSUzI1NiJ9...';
          
          // Perform subsequent API calls in sequence
          return simulateApiCall('/proxy/casAuth', 'POST', { deviceId }, true, 500);
        })
        .then(() => {
          return simulateApiCall('/proxy/accountDetails', 'POST', {}, true, 300);
        })
        .then(() => {
          return simulateApiCall('/proxy/listChannels', 'POST', { languageId: 'spa' }, true, 600);
        })
        .then(() => {
          return simulateApiCall('/static/ncf/top20.json', 'GET', {}, true, 200);
        })
        .then(() => {
          // All API calls successful, show dashboard
          document.getElementById('loginContainer').style.display = 'none';
          document.getElementById('dashboardContainer').style.display = 'block';
          
          // Update time display
          updateTime();
          setInterval(updateTime, 60000);
        })
        .catch(error => {
          // Show error message
          statusMessage.textContent = 'Error de autenticación. Por favor verifique sus credenciales.';
          statusMessage.style.display = 'block';
          statusMessage.classList.add('status-error');
          
          // Reset button state
          spinner.style.display = 'none';
          buttonText.textContent = 'Continuar';
          loginButton.disabled = false;
        });
    });

    // Logout handler
    document.getElementById('logoutButton').addEventListener('click', function() {
      document.getElementById('loginContainer').style.display = 'flex';
      document.getElementById('dashboardContainer').style.display = 'none';
      document.getElementById('email').value = '';
      document.getElementById('password').value = '';
      
      // Reset form state
      const spinner = document.getElementById('loginSpinner');
      const buttonText = document.querySelector('.button-text');
      const loginButton = document.querySelector('.login-button');
      
      spinner.style.display = 'none';
      buttonText.textContent = 'Continuar';
      loginButton.disabled = false;
      
      document.getElementById('statusMessage').style.display = 'none';
      
      // Clear auth token
      authToken = null;
    });

    // Update time display
    function updateTime() {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('currentTime').textContent = `${hours}:${minutes}`;
    }
  </script>
</body>
</html>